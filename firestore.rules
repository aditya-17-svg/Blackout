rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    match /games/{g} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.host == request.auth.uid;
      allow update: if signedIn() && resource.data.host == request.auth.uid;

      match /players/{u} {
        allow read: if signedIn();
        // everyone joins as hider; only the host can make a seeker
        allow create: if signedIn() && request.auth.uid == u && request.resource.data.role == 'hider';
        allow update: if signedIn() && get(/databases/$(db)/documents/games/$(g)).data.host == request.auth.uid;
        // a runner may only mark THEMSELVES as tagged
        allow update: if signedIn() && request.auth.uid == u
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'tagged';
      }
      // private position: only the owner (and the server) can read it
      match /loc/{u} {
        allow read, write: if signedIn() && request.auth.uid == u;
      }
      // live position: only seekers can publish, everyone in the game can see it
      match /live/{u} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == u &&
          get(/databases/$(db)/documents/games/$(g)/players/$(u)).data.role == 'seeker';
      }
      // tag claims: a seeker claims, only the tagged runner can confirm or dispute
      match /tags/{t} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.by == request.auth.uid && request.resource.data.status == 'pending'
          && get(/databases/$(db)/documents/games/$(g)/players/$(request.auth.uid)).data.role == 'seeker';
        allow update: if signedIn() && request.auth.uid == t && request.resource.data.status in ['confirmed', 'disputed'];
        allow delete: if signedIn() && resource.data.by == request.auth.uid;
      }
      // hider positions released at each ping, written only by the server
      match /pings/{p} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
  }
}
